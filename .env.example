# SkyCast AI — SMTP settings for "Forgot password" emails
# Copy this file to `.env` and fill in your own values.
#
# Gmail example (requires a 16-character App Password, NOT your login
# password — create one at https://myaccount.google.com/apppasswords):
#   1. Enable 2-Step Verification on the Google account
#   2. Create an App Password for "Mail"
#   3. Use it below as SMTP_PASS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="SkyCast AI <you@gmail.com>"

# Optional: override the Flask session secret (auto-generated otherwise)
# SKYCAST_SECRET_KEY=some-long-random-string

# --- Admin console credentials (protected /admin/login) --------------------
# ADMIN_EMAIL defaults to admin@skycast.ai.
# ADMIN_PASSWORD defaults to NONE -> the app generates a strong random
# password on first boot and writes EMAIL + PASSWORD to
# data/admin-credentials.txt (gitignored). Set ADMIN_PASSWORD here to use a
# fixed one instead.
ADMIN_EMAIL=admin@skycast.ai
# ADMIN_PASSWORD=


# --- Docker Compose / MongoDB auth (required for docker setup) ----------
# These variables are consumed by docker-compose.yml
MONGO_ROOT_USER=admin_user
MONGO_ROOT_PASSWORD=changeme_now
MONGO_DB_NAME=skycast_db
ME_USERNAME=admin
ME_PASSWORD=changeme_admin
FLASK_ENV=production
SECRET_KEY=changeme_flask_secret

# --- WhatsApp reset codes (optional second forgot-password channel) ------
# Uses the Meta WhatsApp Cloud API (graph.facebook.com). When both values
# are set, users can receive their 6-digit reset code on the WhatsApp
# number saved in their Settings. Unset = channel falls back to dev mode
# (code printed to the server console / data/dev-reset-codes.txt).
# Create a free app at https://developers.facebook.com -> WhatsApp -> API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v19.0


# --- Stripe Checkout (premium subscriptions) ------------------------------
# Test-mode keys come from https://dashboard.stripe.com/test/apikeys
# Leave STRIPE_SECRET_KEY unset and the app degrades gracefully: the pricing
# page falls back to the offline "demo" upgrade endpoint.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: webhook signing secret (whsec_...) for /api/billing/webhook.
# Without it the webhook accepts unsigned JSON (development only).
STRIPE_WEBHOOK_SECRET=
# Optional overrides (defaults: 1500 cents / usd)
# STRIPE_PRICE_CENTS=1500
# STRIPE_CURRENCY=usd


# Notes:
# - If SMTP_HOST is missing, the app runs in DEV MODE: reset codes are
#   printed to the server console instead of being emailed.
# - Port 587 = STARTTLS, port 465 = SSL (both supported).
